# CampusPilot configuration. Copy to `.env` (untracked) and edit.
# Never commit `.env`. All values below are safe defaults.

# --- Deployment mode: local (Mac + Passpoli tunnel) or hosted (Render, bring-your-own key) ---
DEPLOY_MODE=local
# hosted: extra CORS origins, comma separated (the Vercel production URL)
ALLOWED_ORIGINS=
# local = use data/campuspilot.db; release = download the newest index-* GitHub Release at startup
INDEX_SOURCE=local

# --- Your own test key, for local tests and `make smoke-hosted` only. Never deployed. ---
# TEST_LLM_PROVIDER=groq
# TEST_LLM_KEY=

# --- Model (Ollama on Passpoli, through `ssh -fN passpoli-llm`) ---
OLLAMA_BASE_URL=http://127.0.0.1:11500
OLLAMA_MODEL=gemma4:26b-a4b-it-q4_K_M
OLLAMA_TIMEOUT_S=120
# true = scripted fake model (no tunnel needed; for demos and UI work)
CAMPUSPILOT_MOCK_LLM=false

# --- Optional cloud fallback (OpenAI-compatible, e.g. Groq). Off by default. ---
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Moodle data is never sent to any model. Mail text (v2) goes only to the local Gemma,
# or to the cloud fallback only if this is true.
ALLOW_PERSONAL_DATA_TO_CLOUD=false

# --- Moodle (read-only). Prefer Settings in the UI, which stores the token in the macOS Keychain. ---
MOODLE_BASE_URL=https://moodle.iitb.ac.in
# Moodle -> Preferences -> Security keys -> "Moodle mobile web service" key
MOODLE_TOKEN=
# Fallback: Moodle -> Calendar -> Export calendar -> copy URL
MOODLE_ICAL_URL=
# With nothing configured, show clearly-labelled demo deadlines from fixtures.
MOODLE_DEMO_WHEN_UNCONFIGURED=true

# --- v2 connectors (LOCAL MODE ONLY; forced off when DEPLOY_MODE=hosted). docs/CONTRACT.md §11 ---
# Passwords are never put here: connect in the app's Settings (stored in the macOS Keychain).
WEBMAIL_ENABLED=false
ASC_ENABLED=false
GCAL_ENABLED=false
# Labelled fixture mail / ASC data instead of a live account (mock-dev, screenshots).
CONNECTORS_DEMO=false
# IITB webmail over IMAP (read-only). Check Apple Mail -> Settings -> Accounts -> Server Settings.
IMAP_HOST=imap.iitb.ac.in
IMAP_PORT=993
# ASC internal portal (campus network or IITB VPN).
ASC_BASE_URL=https://asc.iitb.ac.in
# Google Calendar: OAuth "Desktop app" client JSON, saved OUTSIDE the repo. Never commit it.
GCAL_CLIENT_FILE=~/.campuspilot/google_client.json
# Live tests use a separate test calendar id, never your main calendar.
GCAL_CALENDAR_ID=primary

# --- Storage (defaults are inside data/, which is gitignored for these files) ---
# CAMPUSPILOT_DB_PATH=data/campuspilot.db
# CAMPUSPILOT_RAW_DIR=data/raw

# --- Agent behaviour ---
# One short extra model call that decides whether to ask a clarifying question first.
CLARIFY_PRECHECK=true
# After a document search, also look up official portal links from the registry.
AUTO_OFFICIAL_LINKS=true

# --- API server (always 127.0.0.1) ---
API_HOST=127.0.0.1
API_PORT=8000
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_PER_DAY=400

# --- Web UI (apps/web reads these at build/dev time) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# true = the UI uses a built-in mock SSE stream and never calls the API
NEXT_PUBLIC_MOCK=false
