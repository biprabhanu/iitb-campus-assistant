# CampusPilot web. Copy to `.env.local` (untracked). Nothing here is secret:
# a student's AI key is pasted into the app in the browser, never put in an env file.

# Where the API runs. Local: http://127.0.0.1:8000. Hosted: your Render URL, e.g. https://campuspilot-api.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# UI work without the API (fake backend). Add ?mockHosted=1 to the URL to see the hosted screens.
# NEXT_PUBLIC_MOCK=true
